# Copy this file to .env before running the app.
# Leave the API keys blank to use procedural decoys and offline fallback.

# Server port. The app defaults to 3000 if this is unset.
PORT=3000

# Optional public-demo guard. When set, protected actions need this token.
# Protected actions: simulator actions, reset, 403 gate, AI reports.
# Clients can send x-demo-token, use ?token= once, or use the lock icon in the top bar.
DEMO_ADMIN_TOKEN=

# Primary AI provider: NVIDIA NIM.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Secondary AI provider: OpenRouter.
# This is used only when NVIDIA_API_KEY is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
