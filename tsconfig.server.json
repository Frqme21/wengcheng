{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["src/client"]
}
